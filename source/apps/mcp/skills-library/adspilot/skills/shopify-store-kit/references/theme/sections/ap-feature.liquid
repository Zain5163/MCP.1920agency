{%- comment -%}
  {{PRODUCT_NAME}} store kit · Featured product: one product, large. Everything shown comes
  from the store (photo, title, price, real option values); the only free text is the
  owner's short line, which must be true.
{%- endcomment -%}
{%- render 'ap-kit-base' -%}
{%- assign s = section.settings -%}
{%- assign product = s.product -%}
{%- if product != blank -%}
<section class="ap-feature ap-section" aria-label="{{ product.title | escape }}" style="--ap-bg: {{ s.background }}; --ap-fg: {{ s.text_color }}; --ap-muted: {{ s.muted_color }}; --ap-accent: {{ s.accent_color }}; --ap-btn-bg: {{ s.text_color }}; --ap-btn-fg: {{ s.background }};">
  <div class="ap-feature__grid ap-wrap page-width-normal">
    <a class="ap-feature__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
      {%- if product.featured_media -%}
        {{ product.featured_media | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 55vw, 100vw', widths: '600, 900, 1200, 1400', alt: product.featured_media.alt | default: product.title }}
      {%- endif -%}
    </a>
    <div class="ap-feature__content">
      {%- if s.eyebrow != blank -%}<p class="ap-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="ap-display ap-feature__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h2>
      <p class="ap-feature__price">
        {%- if product.price_varies -%}From {% endif -%}{{ product.price | money }}
        {%- if product.compare_at_price > product.price %} <s class="ap-muted">{{ product.compare_at_price | money }}</s>{% endif -%}
      </p>
      {%- if s.text != blank -%}<p class="ap-feature__text ap-muted">{{ s.text | escape }}</p>{%- endif -%}
      {%- for option in product.options_with_values -%}
        {%- if option.values.size > 1 -%}
          <p class="ap-feature__opt-label ap-muted">{{ option.name | escape }} · {{ option.values.size }} options</p>
          <ul class="ap-feature__opts" role="list">
            {%- for value in option.values -%}<li>{{ value | escape }}</li>{%- endfor -%}
          </ul>
        {%- endif -%}
      {%- endfor -%}
      <div class="ap-feature__actions">
        <a class="button ap-btn ap-btn--solid" href="{{ product.url }}">{{ s.button_label | escape }}</a>
        {%- if s.link_label != blank -%}<a class="ap-link" href="{{ s.link_url }}">{{ s.link_label | escape }}</a>{%- endif -%}
      </div>
    </div>
  </div>
</section>
{%- endif -%}

{% stylesheet %}
  .ap-feature__grid { display: grid; gap: 28px; padding-block: 56px; align-items: center; }
  @media screen and (min-width: 990px) { .ap-feature__grid { grid-template-columns: 7fr 5fr; gap: 72px; padding-block: 96px; } }
  .ap-feature__media { display: block; background: #fff; aspect-ratio: 1 / 1; overflow: hidden; }
  .ap-feature__media img { width: 100%; height: 100%; object-fit: contain; display: block; transition: transform 0.6s ease; }
  .ap-feature__media:hover img { transform: scale(1.03); }
  .ap-feature__title { font-size: clamp(2.25rem, 5vw, 3.5rem); margin-bottom: 12px; }
  .ap-feature__title a { color: inherit; text-decoration: none; }
  .ap-feature__price { font-size: 1.25rem; font-weight: 600; margin: 0 0 20px; }
  .ap-feature__price s { font-weight: 400; margin-left: 8px; }
  .ap-feature__text { font-size: 1.0625rem; line-height: 1.6; margin: 0 0 24px; max-width: 44ch; }
  .ap-feature__opt-label { font-family: var(--font-accent--family); font-weight: 600; font-size: 0.8125rem; letter-spacing: 0.1em; text-transform: uppercase; margin: 0 0 10px; }
  .ap-feature__opts { list-style: none; margin: 0 0 28px; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .ap-feature__opts li { border: 1px solid color-mix(in srgb, var(--ap-fg) 25%, transparent); padding: 8px 14px; font-size: 0.9375rem; background: color-mix(in srgb, #fff 45%, var(--ap-bg)); }
  .ap-feature__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; }
  @media (prefers-reduced-motion: reduce) { .ap-feature__media img { transition: none; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured product",
  "tag": "div",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Featured" },
    { "type": "text", "id": "text", "label": "Short line (true facts only)" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "View product" },
    { "type": "text", "id": "link_label", "label": "Link" },
    { "type": "url", "id": "link_url", "label": "Link URL" },
    { "type": "color", "id": "background", "label": "Background", "default": "#E9E8E3" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#111315" },
    { "type": "color", "id": "muted_color", "label": "Secondary text", "default": "#5A5F66" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#FF5A1F" }
  ],
  "presets": [{ "name": "Featured product" }]
}
{% endschema %}
