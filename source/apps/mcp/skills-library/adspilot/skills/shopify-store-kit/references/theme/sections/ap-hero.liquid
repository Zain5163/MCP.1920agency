{%- comment -%}
  AdsPilot store kit · Photo hero (the first screen).
  Photo: picked in the theme editor (image settings), or a file shipped in the theme's
  assets/ (asset settings) so the store has a real image before the owner uploads one.
  The image is never lazy-loaded: it is the Largest Contentful Paint element.
{%- endcomment -%}
{%- render 'ap-kit-base' -%}
{%- liquid
  assign s = section.settings
  assign desktop_src = s.desktop_asset | asset_url
  assign mobile_src = desktop_src
  if s.mobile_asset != blank
    assign mobile_src = s.mobile_asset | asset_url
  endif
-%}
<section
  class="ap-hero ap-section"
  aria-label="{{ s.heading | escape }}"
  style="--ap-bg: #111315; --ap-fg: {{ s.text_color }}; --ap-accent: {{ s.accent_color }}; --ap-btn-bg: {{ s.text_color }}; --ap-btn-fg: {{ s.button_text_color }}; --ap-shade: {{ s.overlay | divided_by: 100.0 }};"
>
  <div class="ap-hero__media">
    {%- if s.image != blank -%}
      <picture>
        {%- if s.image_mobile != blank -%}
          <source media="(max-width: 749px)" srcset="{{ s.image_mobile | image_url: width: 900 }} 900w, {{ s.image_mobile | image_url: width: 1300 }} 1300w" sizes="100vw">
        {%- endif -%}
        {{ s.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '800, 1200, 1600, 2000, 2400', alt: s.image.alt, class: 'ap-hero__img' }}
      </picture>
    {%- elsif s.desktop_asset != blank -%}
      <picture>
        <source media="(max-width: 749px)" srcset="{{ mobile_src }}">
        <img class="ap-hero__img" src="{{ desktop_src }}" alt="{{ s.alt | escape }}" width="2000" height="1125" fetchpriority="high" loading="eager">
      </picture>
    {%- endif -%}
  </div>
  <div class="ap-hero__shade" aria-hidden="true"></div>
  <div class="ap-hero__inner ap-wrap page-width-normal">
    <div class="ap-hero__content">
      {%- if s.eyebrow != blank -%}<p class="ap-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      <h1 class="ap-display ap-hero__heading">{{ s.heading | escape }}</h1>
      {%- if s.text != blank -%}<p class="ap-hero__text">{{ s.text | escape }}</p>{%- endif -%}
      <div class="ap-hero__actions ap-stack-mobile">
        {%- if s.button_label != blank -%}
          <a class="button ap-btn ap-btn--solid" href="{{ s.button_link | default: routes.all_products_collection_url }}">{{ s.button_label | escape }}</a>
        {%- endif -%}
        {%- if s.button2_label != blank -%}
          <a class="button-secondary ap-btn ap-btn--outline" href="{{ s.button2_link }}">{{ s.button2_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .ap-hero { position: relative; display: grid; min-height: 74svh; overflow: hidden; isolation: isolate; }
  @media screen and (min-width: 750px) { .ap-hero { min-height: min(88vh, 860px); } }
  .ap-hero__media, .ap-hero__shade { position: absolute; inset: 0; }
  .ap-hero__media { z-index: -2; }
  .ap-hero__media picture { display: block; height: 100%; }
  .ap-hero__img { width: 100%; height: 100%; object-fit: cover; object-position: 60% 50%; display: block; }
  .ap-hero__shade {
    z-index: -1;
    background:
      linear-gradient(to top, rgb(17 19 21 / var(--ap-shade)) 0%, rgb(17 19 21 / calc(var(--ap-shade) * 0.6)) 40%, rgb(17 19 21 / 0) 72%),
      linear-gradient(to right, rgb(17 19 21 / calc(var(--ap-shade) * 0.55)) 0%, rgb(17 19 21 / 0) 55%);
  }
  .ap-hero__inner { display: flex; align-items: flex-end; padding-block: 40px 44px; }
  @media screen and (min-width: 750px) { .ap-hero__inner { padding-block: 64px 72px; } }
  .ap-hero__content { max-width: 680px; }
  .ap-hero__heading { font-size: clamp(2.75rem, 9vw, 5.5rem); line-height: 0.92; }
  .ap-hero__text { font-size: 1.1875rem; line-height: 1.5; margin: 16px 0 0; max-width: 36ch; opacity: 0.92; }
  .ap-hero__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
{% endstylesheet %}

{% schema %}
{
  "name": "Photo hero",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image (overrides the theme photo)" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image (optional, portrait)" },
    { "type": "text", "id": "desktop_asset", "label": "Theme photo file (assets/)", "default": "ap-hero-desktop.jpg" },
    { "type": "text", "id": "mobile_asset", "label": "Theme mobile photo file (assets/)", "default": "ap-hero-mobile.jpg" },
    { "type": "text", "id": "alt", "label": "Theme photo description", "default": "" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "New season" },
    { "type": "text", "id": "heading", "label": "Heading (1–5 words)", "default": "Your headline here." },
    { "type": "text", "id": "text", "label": "Text (one line)" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button2_label", "label": "Second button" },
    { "type": "url", "id": "button2_link", "label": "Second button link" },
    { "type": "color", "id": "text_color", "label": "Text colour", "default": "#F5F4F0" },
    { "type": "color", "id": "accent_color", "label": "Accent colour", "default": "#FF5A1F" },
    { "type": "color", "id": "button_text_color", "label": "Button text colour", "default": "#111315" },
    { "type": "range", "id": "overlay", "label": "Darkening for readable text", "min": 0, "max": 95, "step": 5, "unit": "%", "default": 85 }
  ],
  "presets": [{ "name": "Photo hero" }]
}
{% endschema %}
