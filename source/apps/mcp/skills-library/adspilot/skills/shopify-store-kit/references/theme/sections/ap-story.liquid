{%- comment -%}
  AdsPilot store kit · Story block: image beside a short reason to buy (care, craft,
  origin). One per page, usually dark for contrast with the light sections around it.
{%- endcomment -%}
{%- render 'ap-kit-base' -%}
{%- assign s = section.settings -%}
<section class="ap-story ap-section" aria-label="{{ s.heading | escape }}" style="--ap-bg: {{ s.background }}; --ap-fg: {{ s.text_color }}; --ap-muted: {{ s.muted_color }}; --ap-accent: {{ s.accent_color }}; --ap-btn-bg: {{ s.text_color }}; --ap-btn-fg: {{ s.background }};">
  <div class="ap-story__grid ap-wrap page-width-normal{% if s.image_right %} ap-story__grid--flip{% endif %}">
    <div class="ap-story__media">
      {%- if s.image != blank -%}
        {{ s.image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', widths: '600, 900, 1200, 1400', class: 'ap-story__img' }}
      {%- elsif s.asset != blank -%}
        <img class="ap-story__img" src="{{ s.asset | asset_url }}" alt="{{ s.alt | escape }}" width="1200" height="1350" loading="lazy">
      {%- endif -%}
    </div>
    <div class="ap-story__content">
      {%- if s.eyebrow != blank -%}<p class="ap-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="ap-display ap-story__heading">{{ s.heading | escape }}</h2>
      <div class="ap-story__text ap-muted">{{ s.text }}</div>
      {%- if s.button_label != blank -%}
        <a class="button ap-btn ap-btn--solid" href="{{ s.button_link }}">{{ s.button_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .ap-story__grid { display: grid; gap: 32px; padding-block: 56px; align-items: center; }
  @media screen and (min-width: 990px) {
    .ap-story__grid { grid-template-columns: 1fr 1fr; gap: 72px; padding-block: 96px; }
    .ap-story__grid--flip .ap-story__media { order: 2; }
  }
  .ap-story__media { aspect-ratio: 8 / 9; overflow: hidden; background: color-mix(in srgb, var(--ap-fg) 8%, var(--ap-bg)); }
  .ap-story__img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ap-story__heading { font-size: clamp(2.25rem, 6vw, 4rem); margin-bottom: 20px; }
  .ap-story__text { font-size: 1.0625rem; line-height: 1.6; max-width: 46ch; margin-bottom: 28px; }
  .ap-story__text p { margin: 0 0 12px; }
{% endstylesheet %}

{% schema %}
{
  "name": "Story block",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image (overrides the theme photo)" },
    { "type": "text", "id": "asset", "label": "Theme photo file (assets/)", "default": "ap-story.jpg" },
    { "type": "text", "id": "alt", "label": "Theme photo description", "default": "" },
    { "type": "checkbox", "id": "image_right", "label": "Image on the right (desktop)", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Small label" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One reason, said well." },
    { "type": "richtext", "id": "text", "label": "Text (true claims only)", "default": "<p>Two or three sentences that make the reason to buy concrete.</p>" },
    { "type": "text", "id": "button_label", "label": "Button" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "background", "label": "Background", "default": "#111315" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F5F4F0" },
    { "type": "color", "id": "muted_color", "label": "Secondary text", "default": "#C9CBC7" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#FF5A1F" }
  ],
  "presets": [{ "name": "Story block" }]
}
{% endschema %}
