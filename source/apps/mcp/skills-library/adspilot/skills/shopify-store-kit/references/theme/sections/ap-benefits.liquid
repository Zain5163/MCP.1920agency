{%- comment -%}
  {{PRODUCT_NAME}} store kit · Benefits strip: the store's real promises (delivery, returns,
  payment, help), stated plainly. No cards or shadows. List only promises the store keeps.
{%- endcomment -%}
{%- render 'ap-kit-base' -%}
{%- assign s = section.settings -%}
<section class="ap-benefits ap-section" aria-label="{{ s.label | escape }}" style="--ap-bg: {{ s.background }}; --ap-fg: {{ s.text_color }}; --ap-muted: {{ s.muted_color }}; --ap-line: {{ s.line_color }};">
  <ul class="ap-benefits__list ap-wrap page-width-normal" role="list">
    {%- for block in section.blocks -%}
      <li class="ap-benefits__item" {{ block.shopify_attributes }}>
        <span class="ap-benefits__icon" aria-hidden="true">
          {%- case block.settings.icon -%}
            {%- when 'truck' -%}<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"><path d="M2 6h12v10H2zM14 9h4l4 4v3h-8z"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/></svg>
            {%- when 'return' -%}<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"><path d="M9 7H4V2"/><path d="M4.5 7A8 8 0 1 1 4 14"/></svg>
            {%- when 'lock' -%}<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"><rect x="4" y="10" width="16" height="11"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
            {%- when 'ruler' -%}<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"><path d="M3 16 16 3l5 5L8 21z"/><path d="M7 12l2 2M10 9l2 2M13 6l2 2"/></svg>
            {%- when 'cash' -%}<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"><rect x="2" y="6" width="20" height="12"/><circle cx="12" cy="12" r="2.5"/><path d="M6 9v6M18 9v6"/></svg>
            {%- when 'star' -%}<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z"/></svg>
            {%- else -%}<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"><path d="M4 4h16v12H8l-4 4z"/></svg>
          {%- endcase -%}
        </span>
        <span class="ap-benefits__text">
          <strong>{{ block.settings.title | escape }}</strong>
          {%- if block.settings.text != blank -%}<span>{{ block.settings.text | escape }}</span>{%- endif -%}
        </span>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% stylesheet %}
  .ap-benefits { border-block: 1px solid var(--ap-line); }
  .ap-benefits__list { list-style: none; margin: 0 auto; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 16px; padding-block: 28px; }
  @media screen and (min-width: 990px) { .ap-benefits__list { grid-template-columns: repeat(4, minmax(0, 1fr)); padding-block: 36px; } }
  .ap-benefits__item { display: flex; gap: 12px; align-items: flex-start; }
  .ap-benefits__icon { flex: none; line-height: 0; }
  .ap-benefits__text { display: grid; gap: 2px; font-size: 0.9375rem; line-height: 1.4; }
  .ap-benefits__text strong { font-family: var(--font-heading--family); font-weight: var(--font-heading--weight); font-size: 1.0625rem; letter-spacing: 0.02em; text-transform: uppercase; }
  .ap-benefits__text span { color: var(--ap-muted); }
{% endstylesheet %}

{% schema %}
{
  "name": "Benefits strip",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "label", "label": "Accessible name", "default": "Why shop with us" },
    { "type": "color", "id": "background", "label": "Background", "default": "#F5F4F0" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#111315" },
    { "type": "color", "id": "muted_color", "label": "Secondary text", "default": "#5A5F66" },
    { "type": "color", "id": "line_color", "label": "Lines", "default": "#E2E0DA" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "truck", "options": [
          { "value": "truck", "label": "Delivery" },
          { "value": "return", "label": "Returns" },
          { "value": "lock", "label": "Secure" },
          { "value": "cash", "label": "Cash on delivery" },
          { "value": "ruler", "label": "Size" },
          { "value": "star", "label": "Quality" },
          { "value": "chat", "label": "Help" }
        ] },
        { "type": "text", "id": "title", "label": "Title (a real promise)", "default": "Free delivery" },
        { "type": "text", "id": "text", "label": "Detail" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Benefits strip" }]
}
{% endschema %}
