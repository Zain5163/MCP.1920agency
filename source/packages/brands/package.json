{
  "name": "@social-publisher/brands",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Brand design systems: one folder per brand (tokens, guidelines, logos, fonts), validated, contrast-checked and served to AI clients and people.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.7.2"
  }
}
