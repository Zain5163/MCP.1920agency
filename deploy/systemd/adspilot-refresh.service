[Unit]
Description=AdsPilot: renew expiring platform tokens (Threads, Google)
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
Environment=ADSPILOT_HOME=/opt/adspilot
ExecStart=/bin/bash /opt/adspilot/app/deploy/scripts/dc.sh run --rm -T tasks src/refresh-cli.ts
TimeoutStartSec=15min
