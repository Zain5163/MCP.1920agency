# AdsPilot on the server: the variable NAMES, never values.
#
# The real file is $ADSPILOT_HOME/env/adspilot.env (/opt/adspilot/env/adspilot.env):
#   - it exists only on the server (root:root, chmod 600, folder chmod 700) and,
#     as the full set, in %USERPROFILE%\.social-publisher\.env on the owner's PC;
#   - it is never committed, never pasted into a chat, never copied into
#     D:\My AI Works; deploy/README.md shows how to copy only these names from
#     the PC's file to the server without the values being displayed;
#   - Docker Compose reads it (env_file). A value containing "$" must be put in
#     single quotes, or Compose tries to expand it; the app accepts the quotes.
#
# Names marked [required] stop the MCP or the worker when missing.

# --- Database ----------------------------------------------------------------
# Phase A (Supabase): the same two values as on the PC.
#   DATABASE_URL = Supabase pooler, transaction mode (port 6543, pgbouncer=true)
#   DIRECT_URL   = must be reachable over IPv4 from a container: use the pooler's
#                  SESSION mode address (port 5432), not db.<ref>.supabase.co,
#                  which is IPv6-only on the free plan.
# Phase B (Postgres on this server, decision 0010): both become
#   postgresql://adspilot:<password from env/postgres_password>@postgres:5432/adspilot
# [required]
DATABASE_URL=
# [required by Prisma's migrate/status]
DIRECT_URL=

# --- Encryption ----------------------------------------------------------------
# Must be the SAME key as on the PC, or no stored connection can be decrypted.
# [required]
VAULT_MASTER_KEY=

# --- Shopify store connector (users connect their own stores from their AI chat) ---
# The app "1920 Agency Store Connector" (integrations/shopify-app). Same values as
# on the PC; `shopify app env show` in integrations/shopify-app prints them.
# [required for Shopify]
SHOPIFY_CONNECTOR_CLIENT_ID=
# [required for Shopify]
SHOPIFY_CONNECTOR_CLIENT_SECRET=
# The address users' browsers come back to: PUBLIC_BASE_URL/shopify/callback
PUBLIC_BASE_URL=https://mcp.1920agency.com

# --- Meta app (Facebook Page, Instagram) ----------------------------------------
# [required by monitor and refresh]
META_APP_ID=
# [required]
META_APP_SECRET=
META_API_VERSION=
# used by refresh; same value as on the PC
META_REDIRECT_URI=

# --- Threads (only once Threads is connected) -------------------------------------
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=

# --- Google / YouTube (only once YouTube is connected) ------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
YOUTUBE_UPLOADS_AUDITED=
YOUTUBE_DEFAULT_PRIVACY=
YOUTUBE_CATEGORY_ID=

# --- Alerts and analytics --------------------------------------------------------------
# monitor/refresh/MCP warnings go here (RULES R2)
SLACK_WEBHOOK_URL=
# public capture key; analytics is off without it
POSTHOG_KEY=
POSTHOG_HOST=
# link shown when the free plan runs out
UPGRADE_URL=

# --- Set by docker-compose.yml, do not put in this file ----------------------------------
# MCP_PORT (8080), NODE_OPTIONS, NODE_ENV

# --- PC ONLY: leave these OUT of the server file ------------------------------------------
# Connecting accounts (the CLI on the PC runs the OAuth dialogs):
#   INSTAGRAM_APP_ID INSTAGRAM_APP_SECRET INSTAGRAM_REDIRECT_URI
#   PINTEREST_APP_ID PINTEREST_APP_SECRET PINTEREST_REDIRECT_URI
#   LINKEDIN_APP_ID LINKEDIN_APP_SECRET LINKEDIN_REDIRECT_URI LINKEDIN_API_VERSION
#   LINKEDIN_PAGE_APP_ID LINKEDIN_PAGE_APP_SECRET LINKEDIN_PAGE_REDIRECT_URI
# Media upload when scheduling (CLI and dashboard on the PC):
#   SUPABASE_URL SUPABASE_SERVICE_ROLE_KEY SUPABASE_STORAGE_BUCKET
# Ads tools stay on the local MCP (decision 0005), never on the hosted one:
#   META_AD_ACCOUNT_ID META_ADS_PAGE_ID META_ADS_INSTAGRAM_ID META_PIXEL_ID
#   META_AD_ACCOUNT_CURRENCY META_ADS_ACCESS_TOKEN META_ADS_DAILY_LIMIT
#   META_ADS_MONTHLY_LIMIT META_ADS_DAILY_MINIMUM
#   OPENROUTER_API_KEY OPENROUTER_IMAGE_MODEL OPENROUTER_DAILY_LIMIT_USD
# Dashboard on the PC:
#   APP_PASSWORD MCP_PUBLIC_URL (set it to https://mcp.1920agency.com/mcp so the
#   token page shows the hosted address)
