# AdsPilot hosted MCP: the site block to ADD to Raptor's Caddyfile.
#
# Where it goes: append this block to
#   Websites/Raptor-Downloader/site/deploy/Caddyfile   (Raptor's repo, committed)
# NOT only to the copy on the server: Raptor's release.sh uploads its committed
# deploy/ folder with every API release, which would silently remove a block
# that exists only on the server. Raptor's own blocks stay exactly as they are.
#
# Prerequisites: DNS mcp.1920agency.com -> 37.27.148.217 (live, 2026-10-08),
# the AdsPilot "mcp" container on the edge network adspilot_edge under the alias
# adspilot-mcp (deploy/docker-compose.yml), and Raptor's Caddy attached to that
# network too (Raptor's deploy/docker-compose.yml: caddy networks + the external
# network declaration). Caddy
# obtains and renews the certificate itself, as it does for Raptor's domains.

mcp.1920agency.com {
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}
	# No access log (Caddy's default): requests carry customers' API tokens in
	# the Authorization header, and OAuth codes in callback query strings.

	# The MCP endpoint (streamable HTTP). No compression and no buffering, so a
	# streamed (SSE) reply reaches the AI client as it is written.
	handle /mcp {
		reverse_proxy adspilot-mcp:8080 {
			flush_interval -1
			transport http {
				read_timeout 5m
				write_timeout 5m
			}
		}
	}

	# Uptime check; needs no token and shows only "database reachable or not".
	handle /health {
		reverse_proxy adspilot-mcp:8080
	}

	# OAuth callbacks: the "bounce" (deploy/README.md, "OAuth callbacks").
	# Meta refuses http://localhost redirects while an app is Live, so the
	# provider redirects to https://mcp.1920agency.com/<path>?code=...&state=...
	# and this answers with a 302 to http://localhost:8787/<same path and query>.
	# The owner's own browser then delivers it to the one-shot listener of
	# `pnpm connect` / `pnpm connect:provider` on the PC
	# (source/apps/cli/src/callback-server.ts, 127.0.0.1 only), which checks
	# `state` and exchanges the code exactly as before. No app on this server
	# sees, keeps or logs the code: it only passes through this redirect, to
	# the browser that asked for it.
	#
	# WHY this is safe:
	# - Not an open redirect: the target is fixed (http://localhost:8787) and
	#   only these exact paths match; {uri} is always a path and query, so it
	#   can never change the host. The worst a crafted link can do is send
	#   someone's browser to their OWN localhost:8787.
	# - The code is single-use, short-lived, bound to this app's redirect
	#   address, and worthless without the app secret, which only the PC has.
	#   The listener refuses any callback whose state is not the one it made.
	# - Residual risk, unchanged from the plain localhost redirect: another
	#   program on the PC listening on 8787 during the connect window would
	#   receive the code (it would still need the app secret to use it).
	#
	# Paths: exactly the callback paths the CLI uses, one per provider
	# (connect-provider.ts and the adapters' defaults; checked by
	# source/apps/cli/test/callback-address.test.ts against .env.example).
	# GET only: providers redirect the browser with GET. Anything else falls
	# through to the 404 below.
	# Shopify: the store OWNER's browser arrives here after approving the app
	# (source/apps/mcp/src/shopify-hosted.ts). Unlike the bounce below it is NOT
	# sent to the owner's PC: the user is a customer, so the MCP on this server
	# checks Shopify's signature and AdsPilot's signed state and stores the token.
	# GET only; no caching. /shopify is a small info page for the app's URL.
	@shopify {
		method GET
		path /shopify /shopify/callback
	}
	handle @shopify {
		header Cache-Control "no-store"
		reverse_proxy adspilot-mcp:8080
	}
	# Private brand viewer (source/packages/brands, served by the MCP app;
	# architecture/2026-10-10-brand-design-systems.md). GET and HEAD only:
	# anything else falls through to the 404 below. Every page needs a signed,
	# expiring ?t= link made by the brand_viewer_link tool; without one the app
	# answers the same 404 for every path, so nothing lists or confirms a brand.
	# No cache may keep a page (the address carries the link), and no search
	# engine may index one. There is no access log on this site (see above).
	@brands {
		method GET HEAD
		path /brands /brands/*
	}
	handle @brands {
		header Cache-Control "no-store, private"
		header X-Robots-Tag "noindex, nofollow, noarchive"
		reverse_proxy adspilot-mcp:8080
	}
	@oauth {
		method GET
		path /callback /instagram/callback /threads/callback /pinterest/callback /linkedin/callback /linkedin-page/callback /google/callback
	}
	handle @oauth {
		# The redirect carries a one-time code; no cache may keep it.
		header Cache-Control "no-store"
		redir http://localhost:8787{uri} 302
	}

	handle {
		respond "Not found. The MCP endpoint is /mcp." 404
	}
}
