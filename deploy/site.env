# deploy/site.env: WHERE this deployment runs. The one place for these values.
#
# NO SECRETS here: this file is committed. Secrets stay in the server's
# $ADSPILOT_HOME/env/adspilot.env and the PC's %USERPROFILE%\.social-publisher\.env.
#
# Read by every script in deploy/scripts (through site.sh), by docker-compose.yml
# (dc.sh exports DOMAIN, so the MCP gets PUBLIC_BASE_URL=https://$DOMAIN), and by
# deploy/scripts/caddy-site.sh, which renders the gate's site file from
# deploy/caddy/site.caddy.template. The product's NAME is not here: that is
# source/packages/config/src/product.ts (see architecture/2026-10-10-central-config.md).
#
# Format: NAME=value, one per line, no quotes, no $VARIABLES. A leading ~/ means
# the home folder. A variable already set in the environment wins (a one-off
# override, e.g. ADSPILOT_HOME from a systemd unit).

# --- Public address -----------------------------------------------------------------
# The hosted MCP's domain: https://$DOMAIN/mcp, /health, /shopify, the OAuth bounce.
# Temporary (the product name and its domain are not final). To move it, follow
# "Change the domain" in START-HERE.md: DNS, this line, caddy-site.sh --upload,
# release.sh, then the provider consoles and the Shopify app.
DOMAIN=mcp.1920agency.com

# --- The server -----------------------------------------------------------------------
SERVER_HOST=37.27.148.217
SERVER_USER=root
# The SSH private key on the owner's PC (never in the workspace).
SSH_KEY=~/.ssh/raptor_hetzner
# The front gate shared by every site on the server (AI-Automation/Server-Gate).
# This project owns exactly one file there: sites/$DOMAIN.caddy.
GATE_DIR=/opt/gate

# --- Fixed names on the server ----------------------------------------------------------
# These name things that already exist on the live server (folders, containers,
# networks, volumes, timers, backup files). They are NOT renamed with the product:
# changing one on a running server would start a second, empty stack beside the
# first. Change only when building a new server from scratch.
ADSPILOT_HOME=/opt/adspilot
COMPOSE_PROJECT=adspilot
EDGE_NETWORK=adspilot_edge

# --- The OAuth bounce ---------------------------------------------------------------------
# The gate answers https://$DOMAIN/<callback path> with a 302 to
# http://localhost:$OAUTH_BOUNCE_PORT/<same path>, where the PC's connect command
# listens. Must equal OAUTH_CALLBACK_PORT's default in product.ts (tested).
OAUTH_BOUNCE_PORT=8787
