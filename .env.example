# AdsPilot configuration template.
#
# Copy to ~/.social-publisher/.env and fill in. Never commit the real file —
# it lives outside this repository on purpose.

# --- Database (Supabase) ---------------------------------------------------
# DATABASE_URL must include sslmode=require, or Prisma reports a misleading
# "authentication failed" even when the credentials are correct.
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true&sslmode=require
DIRECT_URL=postgresql://user:password@host:5432/postgres?sslmode=require

# --- Meta app --------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v25.0
META_REDIRECT_URI=http://localhost:8787/callback

# --- OAuth callbacks: localhost or the hosted bounce --------------------------
# Every *_REDIRECT_URI in this file takes either form, with the same path:
#   http://localhost:8787/<path>          the provider redirects straight to this PC
#   https://mcp.1920agency.com/<path>     the hosted server bounces the browser on
#                                         to http://localhost:8787/<path> here
# The https form is for apps that refuse localhost (Meta while Live). Register
# the address in the provider's console FIRST, then change it here, then
# reconnect: deploy/README.md, "OAuth callbacks", has the checklist.
# Optional: the port the connect command listens on for an https address
# (default 8787, where the bounce points). Leave unset unless the bounce in
# deploy/caddy/mcp.1920agency.com.caddy was changed to match.
# OAUTH_CALLBACK_PORT=8787

# --- Instagram direct login (optional) -------------------------------------
# For businesses that have an Instagram account and NO Facebook Page. Meta's own
# docs: this setup "does not require a Facebook Page to be linked".
#
# These are the INSTAGRAM app id and secret, shown on the Instagram product page
# in the Meta app — not the Meta app id above. Different numbers entirely.
#
# Not needed when the Instagram account is already linked to a connected Page:
# that route brings Instagram along already, and a second authorisation for one
# account would be worse than useless.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8787/instagram/callback

# --- Meta Ads --------------------------------------------------------------
# The ad account id WITHOUT the act_ prefix; the code adds it.
META_AD_ACCOUNT_ID=
# The Page ads are published by. Meta requires one even for Instagram placements.
META_ADS_PAGE_ID=
META_ADS_INSTAGRAM_ID=
# Required for conversion optimisation. Without it those goals are refused.
META_PIXEL_ID=
META_AD_ACCOUNT_CURRENCY=
# Needs ads_management. The Page token used for publishing is NOT enough.
# A System User token survives a password change; a personal one does not.
META_ADS_ACCESS_TOKEN=

# --- Threads app (optional) ------------------------------------------------
# NOT the Meta app above. Threads has its own host, OAuth and scopes, and needs
# a Meta app configured for the Threads use case.
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=http://localhost:8787/threads/callback

# --- Pinterest app (optional) ----------------------------------------------
# WARNING: under Trial access, pins are visible only to you. Everything reports
# success. Standard Access needs a submitted video of the app in use.
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:8787/pinterest/callback

# --- LinkedIn app (optional) -----------------------------------------------
# Needs TWO self-serve products on the app: "Share on LinkedIn" (w_member_social)
# and "Sign In with LinkedIn using OpenID Connect" (openid, profile, /v2/userinfo).
# Both are instant. Without the second, account discovery cannot identify who
# authorised and the connect fails.
LINKEDIN_APP_ID=
LINKEDIN_APP_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8787/linkedin/callback
# Month-versioned API (YYYYMM). LinkedIn retires a version after about a year.
LINKEDIN_API_VERSION=202601

# --- LinkedIn PAGE app (a SECOND app) --------------------------------------
# For posting as a company page. It must be a separate LinkedIn app, because
# Community Management and Sign In with OpenID Connect cannot both be on one
# app — with OIDC enabled, Community Management cannot even be requested.
# Confirmed 2026-09-26.
#
# This app needs Community Management API APPROVED. While the request is still
# pending, connecting reports that it administers no pages rather than failing.
LINKEDIN_PAGE_APP_ID=
LINKEDIN_PAGE_APP_SECRET=
LINKEDIN_PAGE_REDIRECT_URI=http://localhost:8787/linkedin-page/callback

# --- Google: YouTube (optional) ----------------------------------------------
# An OAuth client of type "Web application" in the Google Cloud project, with
# the YouTube Data API v3 enabled and the redirect below registered EXACTLY
# (localhost, not 127.0.0.1; no trailing slash). See SETUP.md section 8.
# Connect with:  pnpm connect:provider google youtube   (in source/apps/cli)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. This is the default.
GOOGLE_REDIRECT_URI=http://localhost:8787/google/callback

# --- YouTube uploads (optional) ---------------------------------------------
# Leave false until the Cloud project has PASSED the YouTube API audit. Until
# then YouTube restricts every API upload to private, with no appeal, so
# uploads are sent private and reported as "uploaded, private", never as
# published. Only an explicit true (or 1, yes) counts.
YOUTUBE_UPLOADS_AUDITED=false
# private, unlisted or public. Used only once audited; anything else is private.
YOUTUBE_DEFAULT_PRIVACY=private
# Category id, a string. 22 = People & Blogs (Google's own sample default).
YOUTUBE_CATEGORY_ID=22

# --- Media hosting (Instagram fetches media by URL; Facebook does not) ------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media

# --- Encryption ------------------------------------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this means every connected account must be reconnected.
VAULT_MASTER_KEY=

# --- Dashboard -------------------------------------------------------------
APP_PASSWORD=

# --- Operational alerts (optional) -----------------------------------------
SLACK_WEBHOOK_URL=

# --- Meta Ads spend ceiling ------------------------------------------------
# Whole units of the account currency. The DAILY figure covers ALL active
# campaigns together, not each one. Ten campaigns at 5,000 a day is 50,000.
# Nothing that can spend will run while these are empty. There is deliberately
# no default: a ceiling the software picked is not one you chose.
META_ADS_DAILY_LIMIT=
META_ADS_MONTHLY_LIMIT=

# --- Image generation (OpenRouter, paid per image) --------------------------
# Key from openrouter.ai/keys. One key reaches Google, OpenAI and other models.
OPENROUTER_API_KEY=
# Default makes every ad shape (1:1, 4:5, 9:16). OpenAI's gpt-image-2 has no 4:5.
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
# Most to spend on images per day, in US dollars. Nothing is generated while this
# is empty. Images cost roughly $0.03-0.08 each, so 5 covers about 60-150 images.
OPENROUTER_DAILY_LIMIT_USD=
