# AdsPilot configuration template.
#
# Copy to ~/.social-publisher/.env and fill in. Never commit the real file —
# it lives outside this repository on purpose.

# --- Database (Supabase) ---------------------------------------------------
# DATABASE_URL must include sslmode=require, or Prisma reports a misleading
# "authentication failed" even when the credentials are correct.
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true&sslmode=require
DIRECT_URL=postgresql://user:password@host:5432/postgres?sslmode=require

# --- Meta app --------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v25.0
META_REDIRECT_URI=http://localhost:8787/callback

# --- Threads app (optional) ------------------------------------------------
# NOT the Meta app above. Threads has its own host, OAuth and scopes, and needs
# a Meta app configured for the Threads use case.
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=http://localhost:8787/threads/callback

# --- Pinterest app (optional) ----------------------------------------------
# WARNING: under Trial access, pins are visible only to you. Everything reports
# success. Standard Access needs a submitted video of the app in use.
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:8787/pinterest/callback

# --- LinkedIn app (optional) -----------------------------------------------
# Needs TWO self-serve products on the app: "Share on LinkedIn" (w_member_social)
# and "Sign In with LinkedIn using OpenID Connect" (openid, profile, /v2/userinfo).
# Both are instant. Without the second, account discovery cannot identify who
# authorised and the connect fails.
LINKEDIN_APP_ID=
LINKEDIN_APP_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8787/linkedin/callback
# Month-versioned API (YYYYMM). LinkedIn retires a version after about a year.
LINKEDIN_API_VERSION=202601
# Set to true ONLY after LinkedIn approves the Community Management API.
# Requesting organisation scopes without approval makes the authorisation dialog
# refuse outright — which blocks personal posting too, not just company pages.
LINKEDIN_ORGANIZATION_ACCESS=false

# --- Media hosting (Instagram fetches media by URL; Facebook does not) ------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media

# --- Encryption ------------------------------------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this means every connected account must be reconnected.
VAULT_MASTER_KEY=

# --- Dashboard -------------------------------------------------------------
APP_PASSWORD=

# --- Operational alerts (optional) -----------------------------------------
SLACK_WEBHOOK_URL=
